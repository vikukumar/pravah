# ==============================================================================
# PRAVAH — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application
PROJECT_NAME="PRAVAH"
ENVIRONMENT="production"
VERSION="1.0.0"
DEBUG=false
API_V1_STR="/api/v1"

# Database Connections (PostgreSQL & SQLite)
# For local SQLite: sqlite+aiosqlite:///./pravah.db
# For PostgreSQL:
DATABASE_URL="postgresql+asyncpg://pravah_user:pravah_password@localhost:5432/pravah_db"
DATABASE_SYNC_URL="postgresql://pravah_user:pravah_password@localhost:5432/pravah_db"

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# Cryptographic & Security Keys (MINIMUM 32 CHARACTERS)
SECRET_KEY="generate_a_secure_master_jwt_secret_key_minimum_32_characters"
ENCRYPTION_KEY="generate_a_secure_fernet_aes_encryption_key_32_bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenRouter & AI Integration
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
DEFAULT_AI_MODEL="anthropic/claude-3.5-sonnet"
IMAGE_AI_MODEL="stabilityai/stable-diffusion-xl"

# Payment Gateways (Razorpay & Cashfree)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="TEST" # or PROD

# Social Media OAuth Credentials
X_CLIENT_ID="your_x_twitter_client_id"
X_CLIENT_SECRET="your_x_twitter_client_secret"

META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

GOOGLE_CLIENT_ID="your_google_youtube_client_id"
GOOGLE_CLIENT_SECRET="your_google_youtube_client_secret"

# Frontend Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
