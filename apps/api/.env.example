# PRAVAH Backend Environment Configuration
PROJECT_NAME=PRAVAH
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# URLs & CORS
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security Secrets (Change in Production)
SECRET_KEY=change_this_to_a_secure_random_32_char_secret_key_in_production
ENCRYPTION_KEY=ZXZhbHVhdGlvbl9lbmNyeXB0aW9uX2tleV9mb3JfcHJhdmFoX3NlY3VyZQ==
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Database (PostgreSQL for production or SQLite for local)
DATABASE_URL=sqlite+aiosqlite:///./pravah.db
DATABASE_SYNC_URL=sqlite:///./pravah.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pravah

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# AI Gateways
OPENROUTER_API_KEY=
DEFAULT_AI_MODEL=anthropic/claude-3.5-sonnet
IMAGE_AI_MODEL=stabilityai/stable-diffusion-xl
